# WORKERS-01 held example. This file contains no secret value and grants no
# worker, database, provider, publication, commercial, or deployment authority.
SITESOURCERY_WORKER_CONFIG='{"schema":"sitesourcery.worker-process-config/v1","activation":"held","purposes":["export","cancellation","notification-mail","alakazam-fulfillment","alakazam-retained-lifecycle","responder-fulfillment","provider-reconciliation","responder-retention","project-lifecycle","domain-lifecycle","care-lifecycle"],"approvalPath":"/etc/sitesourcery/WORKERS_APPROVED","shutdownDeadlineMs":20000,"loop":{"intervalMs":5000,"errorBackoffMs":5000,"maximumBackoffMs":60000}}'
SITESOURCERY_POSTGRES_BUDGET_CONFIG='{"schema":"sitesourcery.postgres-budget-config/v1","timeouts":{"statementMs":15000,"lockMs":3000,"idleInTransactionMs":30000,"acquisitionMs":5000},"pool":{"totalConnections":10,"apiConnections":8,"workerReservedConnections":2,"connectionIncrease":"none"}}'
SITESOURCERY_DATABASE_URL=replace-with-root-owned-secret-reference
SITESOURCERY_DATABASE_SSL=require
SITESOURCERY_PUBLICATION_COMMAND_SOCKET=/run/sitesourcery/publication-command-v1.sock
SITESOURCERY_PUBLICATION_COMMAND_TOKEN=replace-with-exact-32-byte-base64url-secret
SITESOURCERY_PUBLICATION_COMMAND_MAX_BODY_BYTES=16777216
SITESOURCERY_PUBLICATION_COMMAND_DEADLINE_MS=15000
SITESOURCERY_DATA_ROOT=/var/lib/sitesourcery
SITESOURCERY_EXPORT_ROOT=/var/lib/sitesourcery/private-exports
SITESOURCERY_EXPORT_WORKER_MODE=held
SITESOURCERY_NOTIFICATION_MAIL_WORKER_MODE=held
# The provider reconciliation worker is read-only: it detects abandoned
# claims, uncertain Message creates, stale delivery statuses, unmatched
# provider events, unbound inbound events, and cross-keyring binding
# ambiguity; re-runs the proved idempotent delivery-event reconciler; and
# escalates abandoned claims to manual review only after revalidating the
# expired attempt and lease owner. It never retries a provider create. Twilio
# readback (read-only Messages enumeration with in-memory SID or
# route/content-digest candidate matching) is independently held; the loop
# runs detection and operator projection whether or not readback is verified.
SITESOURCERY_PROVIDER_RECONCILIATION_WORKER_MODE=held
SITESOURCERY_PROVIDER_RECONCILIATION_MAXIMUM_READBACKS_PER_CYCLE=8
SITESOURCERY_TWILIO_READBACK_MODE=held
# Responder private-material retention is an independently held destructive
# purpose. Once the owner has accepted restore/policy proof and activates it,
# it leases lifecycle-eligible rows, rechecks operator legal/retention holds,
# zeroes ciphertext in the primary database, and records digest-only receipts.
# It has no vault/decryption port and acknowledges that encrypted backup copies
# can retain earlier bytes for the separately proved 30-day backup horizon.
SITESOURCERY_RESPONDER_RETENTION_WORKER_MODE=held
SITESOURCERY_RESPONDER_RETENTION_MAXIMUM_DISCOVERIES_PER_CYCLE=100
SITESOURCERY_RESPONDER_RETENTION_MAXIMUM_DESTRUCTIONS_PER_CYCLE=16
SITESOURCERY_RESPONDER_RETENTION_LEASE_SECONDS=120
# Project lifecycle is destructive only after the separately authenticated
# owner deletion request has sealed a purging record. Retention expiry itself
# becomes manual review; publication removal, private object deletion, and
# terminal database finalization are separately leased and ordered.
SITESOURCERY_PROJECT_LIFECYCLE_WORKER_MODE=held
SITESOURCERY_PROJECT_LIFECYCLE_WORKER_BATCH_LIMIT=10
SITESOURCERY_PROJECT_LIFECYCLE_WORKER_LEASE_SECONDS=120
# Domain lifecycle is readback/reconciliation-only. Reviewed mode requires a
# root-owned adapter whose exact digest is pinned; no registrar write scope is
# accepted by the worker contract.
SITESOURCERY_DOMAIN_LIFECYCLE_WORKER_MODE=held
SITESOURCERY_DOMAIN_LIFECYCLE_READBACK_MODE=held
# SITESOURCERY_DOMAIN_LIFECYCLE_READBACK_MODULE=/etc/sitesourcery/domain/lifecycle-readback.mjs
# SITESOURCERY_DOMAIN_LIFECYCLE_READBACK_SHA256=replace-with-reviewed-sha256
SITESOURCERY_DOMAIN_LIFECYCLE_WORKER_BATCH_LIMIT=10
SITESOURCERY_DOMAIN_LIFECYCLE_WORKER_LEASE_SECONDS=120
# Care lifecycle closes one exact period and opens its next calendar month.
# Only unused included units carry once; carried units never carry again.
SITESOURCERY_CARE_LIFECYCLE_WORKER_MODE=held
SITESOURCERY_CARE_LIFECYCLE_WORKER_BATCH_LIMIT=10
SITESOURCERY_CARE_LIFECYCLE_WORKER_LEASE_SECONDS=120
SITESOURCERY_NOTIFICATION_MAIL_PRIVATE_RENDERER_MODE=held
# Owner-approved notification mail additionally requires a digest-pinned,
# standalone copy of ops/notification-mail-private-renderer.mjs under
# /etc/sitesourcery/mail/ plus the existing root-owned Resend API key/domain
# variables. No private recipient or credential is present in this held file.
# SITESOURCERY_NOTIFICATION_MAIL_RENDERER_MODULE=/etc/sitesourcery/mail/private-renderer.mjs
# SITESOURCERY_NOTIFICATION_MAIL_RENDERER_SHA256=replace-with-reviewed-sha256
# SITESOURCERY_NOTIFICATION_MAIL_PRIVATE_RENDERER_MODE=reviewed
# SITESOURCERY_NOTIFICATION_MAIL_TEMPLATE_REGISTRY_SHA256=f16c963c1cdd7dfb7801eddac0eb92d559e520bda7ee2a0d54bd723597b9cd14
# SITESOURCERY_NOTIFICATION_MAIL_OPERATOR_RECIPIENT=replace-with-private-operator-address
SITESOURCERY_STRIPE_MODE=held
SITESOURCERY_LICENSED_BASE_DOMAIN=sites.example.invalid
SITESOURCERY_SPARK_COMPILER_SHA256=replace-with-reviewed-sha256
SITESOURCERY_ALAKAZAM_MODE=held
SITESOURCERY_ALAKAZAM_LIFECYCLE_MODE=held
SITESOURCERY_RESPONDER_FULFILLMENT_WORKER_MODE=held
# approved_live remains unavailable until the separately reviewed,
# digest-bound Twilio provider and private material resolver are installed and
# verified. The HQ phone bridge is a distinct read-only operator surface.
# SITESOURCERY_RESPONDER_MATERIAL_KEY_VERSION=replace-with-nonsecret-version
# SITESOURCERY_RESPONDER_MATERIAL_KEY_BASE64URL=replace-with-root-owned-secret-reference
# Optional bounded read-only rotation overlap; both prior values are required.
# SITESOURCERY_RESPONDER_MATERIAL_PRIOR_KEY_VERSION=replace-with-nonsecret-version
# SITESOURCERY_RESPONDER_MATERIAL_PRIOR_KEY_BASE64URL=replace-with-root-owned-secret-reference
# Inbound follow-up receives no lookup keyring. The API-bound caller digest is
# authenticated by the inbound envelope AAD, then the opened caller must match
# the exact active consent route before any outbound material can be sealed.
# SITESOURCERY_TWILIO_ACCOUNT_SID=replace-with-reviewed-provider-binding
# SITESOURCERY_TWILIO_API_KEY_SID=replace-with-reviewed-restricted-key-binding
# SITESOURCERY_TWILIO_API_KEY_SECRET=replace-with-root-owned-secret-reference
# SITESOURCERY_TWILIO_MESSAGING_SERVICE_SID=replace-with-reviewed-provider-binding
# SITESOURCERY_TWILIO_BRAND_REGISTRATION_SID=replace-with-reviewed-provider-binding
# SITESOURCERY_TWILIO_A2P_CAMPAIGN_SID=replace-with-reviewed-provider-binding
# SITESOURCERY_TWILIO_STATUS_CALLBACK_URL=https://sitesourcery.com/api/v1/provider-events/twilio
# The Twilio Account Auth Token used for callback signatures is deliberately
# absent from the worker environment. It belongs only to the hosted API's
# independent verified provider-event ingress.

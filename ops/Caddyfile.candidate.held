# PUBLICATION_HOLD — review only. Do not load, adapt, install, or reload.
# Requires owner approval, DNS proof, router/ISP proof, ACME staging proof,
# exact Caddy-version validation, and removal of /etc/sitesourcery/PUBLICATION_HOLD.

{
	admin unix//run/caddy/sitesourcery-admin.sock
	persist_config off
	email {$SITESOURCERY_ACME_EMAIL}

	on_demand_tls {
		ask http://127.0.0.1:8080/_sitesourcery/tls/allow
	}

	servers {
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 2m
		}
		max_header_size 32KB
		strict_sni_host on
	}
}

https:// {
	tls {
		on_demand
	}

	@sitesourcery_internal path /_sitesourcery/*
	respond @sitesourcery_internal 404

	reverse_proxy 127.0.0.1:8080
}

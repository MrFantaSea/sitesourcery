# Copy to /etc/sitesourcery/hosted.env with mode 0600.
# Secret values belong in the real root-owned file, never in Git.
SITESOURCERY_HOSTED_HOST=127.0.0.1
SITESOURCERY_HOSTED_PORT=8788
SITESOURCERY_PUBLICATION_COMMAND_SOCKET=/run/sitesourcery/publication-command-v1.sock
SITESOURCERY_PUBLICATION_COMMAND_TOKEN=replace-with-exact-32-byte-base64url-secret
SITESOURCERY_PUBLICATION_COMMAND_MAX_BODY_BYTES=16777216
SITESOURCERY_PUBLICATION_COMMAND_DEADLINE_MS=15000
# Non-secret, root-owned final held release identity. Startup rejects an absent,
# relative, symlinked, malformed, tampered, or effect-bearing receipt.
SITESOURCERY_RELEASE_EPOCH_FILE=/etc/sitesourcery/final-release-epoch-v2.json
SITESOURCERY_RELEASE_EPOCH_SHA256=replace-with-exact-file-sha256
SITESOURCERY_ORIGIN_SEAL_FILE=/etc/sitesourcery/origin-seal.json
SITESOURCERY_ORIGIN_SEAL_FILE_SHA256=replace-with-exact-file-sha256
SITESOURCERY_ORIGIN_INSTALLED_READBACK_FILE=/etc/sitesourcery/origin-installed-readback.json
SITESOURCERY_ORIGIN_INSTALLED_READBACK_FILE_SHA256=replace-with-exact-file-sha256
# Conservative ingress bounds. Invalid or out-of-range values fail startup.
SITESOURCERY_MAX_JSON_BODY_BYTES=1048576
SITESOURCERY_MAX_WEBHOOK_BODY_BYTES=262144
SITESOURCERY_MAX_CONCURRENT_REQUESTS=64
SITESOURCERY_REQUEST_DEADLINE_MS=15000
SITESOURCERY_IDENTITY_SUBJECT_ATTEMPTS=6
SITESOURCERY_IDENTITY_SUBJECT_WINDOW_MS=900000
SITESOURCERY_IDENTITY_SUBJECT_BLOCK_MS=900000
SITESOURCERY_IDENTITY_IP_ATTEMPTS=12
SITESOURCERY_IDENTITY_IP_WINDOW_MS=900000
SITESOURCERY_IDENTITY_IP_BLOCK_MS=900000
SITESOURCERY_IDENTITY_GLOBAL_ATTEMPTS=120
SITESOURCERY_IDENTITY_GLOBAL_WINDOW_MS=900000
SITESOURCERY_IDENTITY_GLOBAL_BLOCK_MS=900000
SITESOURCERY_PROJECT_WRITE_ATTEMPTS=120
SITESOURCERY_PROJECT_WRITE_WINDOW_MS=900000
SITESOURCERY_COMPILE_ATTEMPTS=20
SITESOURCERY_COMPILE_WINDOW_MS=900000
SITESOURCERY_DATA_ROOT=/var/lib/sitesourcery
SITESOURCERY_EXPORT_ROOT=/var/lib/sitesourcery/private-exports
SITESOURCERY_LICENSED_BASE_DOMAIN=sites.example.invalid
SITESOURCERY_DATABASE_SSL=require
SITESOURCERY_DATABASE_URL=replace-with-secret-reference
# Non-secret, exact v1 PostgreSQL budget metadata. This default preserves the
# driver's existing ten-connection ceiling and holds two slots out of API use.
SITESOURCERY_POSTGRES_BUDGET_CONFIG='{"schema":"sitesourcery.postgres-budget-config/v1","timeouts":{"statementMs":15000,"lockMs":3000,"idleInTransactionMs":30000,"acquisitionMs":5000},"pool":{"totalConnections":10,"apiConnections":8,"workerReservedConnections":2,"connectionIncrease":"none"}}'
# Versioned identity configuration contains metadata and environment names only.
# The example values remain deliberately unusable and held.
SITESOURCERY_IDENTITY_PEPPER_CONFIG='{"schema":"sitesourcery.identity-pepper-config/v1","current":{"version":"replace-current-version","secretEnvironment":"SITESOURCERY_IDENTITY_PEPPER"},"prior":[]}'
SITESOURCERY_IDENTITY_PEPPER=replace-with-base64-secret
SITESOURCERY_ENGAGEMENT_TOKEN_SECRET=replace-with-independent-base64-secret
# During an approved overlap, add at most three explicitly versioned prior
# readers to the config and populate only their matching root-owned variables.
# SITESOURCERY_IDENTITY_PEPPER_PRIOR_1=replace-with-prior-base64-secret
# SITESOURCERY_IDENTITY_PEPPER_PRIOR_2=replace-with-prior-base64-secret
# SITESOURCERY_IDENTITY_PEPPER_PRIOR_3=replace-with-prior-base64-secret
SITESOURCERY_CONTACT_VAULT_KEY=replace-with-base64-secret
SITESOURCERY_SPARK_COMPILER_SHA256=replace-with-reviewed-sha256
# Leave SITESOURCERY_OFFER_CATALOG_PATH unset while commerce is held. Configure
# it only after an exact reviewed production catalog exists.
# SITESOURCERY_OFFER_CATALOG_PATH=/etc/sitesourcery/catalog.json
SITESOURCERY_REGISTRATION_MAIL_MODE=held
SITESOURCERY_REGISTRATION_TRANSPORT_MODULE=/opt/sitesourcery/current/server/hosted/resend-mail-transport.mjs
SITESOURCERY_RECOVERY_MAIL_MODE=held
SITESOURCERY_RECOVERY_TRANSPORT_MODULE=/opt/sitesourcery/current/server/hosted/resend-mail-transport.mjs
SITESOURCERY_RESEND_WEBHOOK_MODE=held
# Set the root-owned signing secret only when changing the exact mode above to
# verified. A secret present while the mode is held fails startup closed.
# SITESOURCERY_RESEND_WEBHOOK_SIGNING_SECRET=replace-with-secret-reference
# Twilio Responder boundaries are independently held by default. Any verified
# Twilio mode resolves customer authority from one shared external registry:
# one organization, one Twilio subaccount, and customer-specific Messaging,
# compliance, webhook-signing, Voice, and Push Credential authority. The
# registry must be an absolute, regular, non-symlink file no larger than 256
# KiB, owned outside the source tree, and mode 0400/0440/0600/0640 without
# group-write or world bits. Raw provider identifiers and secrets never belong
# in this environment, Git, PostgreSQL, logs, receipts, or provenance.
#
# Keep the path absent while every Twilio mode is held. Before any mode becomes
# verified, install the same root/service-group-readable registry path in each
# process that needs customer resolution.
# SITESOURCERY_TWILIO_ISV_PROVIDER_REGISTRY_PATH=/etc/sitesourcery/twilio-isv-provider-registry.json
#
# Provider-event ingress requires the exact production callback URL. It selects
# the customer from the untrusted callback AccountSid, validates the signature
# with only that subaccount's Auth Token, and then requires the matching active
# digest-only PostgreSQL topology.
SITESOURCERY_TWILIO_RESPONDER_EVENT_MODE=held
# SITESOURCERY_TWILIO_STATUS_CALLBACK_URL=replace-with-reviewed-production-callback
# Twilio inbound SMS and Voice ingress is a second independent held-by-default
# API boundary. Verified mode selects and authenticates the same customer
# subaccount, additionally requires the exact production inbound URLs, and
# requires the Responder material sealing keys in this API environment;
# staging the material key while inbound is held fails startup closed.
# Phone-derived lookup digests are keyed through the identity pepper.
# Voice dialing is independently held. Verified mode resolves only an
# operator-provisioned encrypted target bound to the exact active provider
# number, and renders <Dial action> only after signed durable arrival evidence.
SITESOURCERY_TWILIO_INBOUND_EVENT_MODE=held
SITESOURCERY_TWILIO_VOICE_DIAL_MODE=held
# Native iPhone/Android Twilio Voice access is a third independent boundary.
# Held mode receives no provider authority; the shared registry path may still
# be present for a separately verified callback purpose. Verified issuance
# chooses only the requesting organization's customer-specific Voice key and
# platform/environment Push Credential after matching active topology. Change
# this only through the later reviewed provider-purpose release gate.
SITESOURCERY_TWILIO_VOICE_ACCESS_MODE=held
# SITESOURCERY_TWILIO_INBOUND_MESSAGE_URL=replace-with-reviewed-production-inbound-message-url
# SITESOURCERY_TWILIO_INBOUND_VOICE_URL=replace-with-reviewed-production-voice-url
# SITESOURCERY_TWILIO_INBOUND_DIAL_RESULT_URL=replace-with-reviewed-production-dial-result-url
# SITESOURCERY_RESPONDER_MATERIAL_KEY_VERSION=replace-with-nonsecret-version
# SITESOURCERY_RESPONDER_MATERIAL_KEY_BASE64URL=replace-with-root-owned-secret-reference
# SITESOURCERY_RESPONDER_MATERIAL_PRIOR_KEY_VERSION=replace-with-nonsecret-version
# SITESOURCERY_RESPONDER_MATERIAL_PRIOR_KEY_BASE64URL=replace-with-root-owned-secret-reference
SITESOURCERY_RESEND_API_KEY=replace-with-secret-reference
SITESOURCERY_RESEND_DOMAIN_ID=replace-with-resend-domain-uuid
SITESOURCERY_STRIPE_MODE=held
# Approved production-live mode also requires the exact restricted-key
# topology plus a non-secret, root-owned activation receipt issued from a
# fresh (15-minute) dashboard scope readback. The receipt is bound to the
# account, key fingerprint/version, enabled purposes, topology digest, scope
# evidence, and an expiry no more than 366 days after activation.
# SITESOURCERY_CREDENTIAL_TOPOLOGY_JSON=replace-with-reviewed-topology-json
# SITESOURCERY_STRIPE_CREDENTIAL_ACTIVATION_RECEIPT_JSON=replace-with-issued-receipt-json
# Public, non-secret joint legal V3 production tuple. These values must remain
# identical to the retained finalization receipt and migration 48.

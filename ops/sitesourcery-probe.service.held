# PUBLICATION_HOLD — template only. Do not copy, enable, or start.

[Unit]
Description=Probe Site Sourcery loopback runtime
After=sitesourcery-hosted.service sitesourcery-tenant.service
Requires=sitesourcery-hosted.service sitesourcery-tenant.service
ConditionPathExists=/etc/sitesourcery/RUNTIME_APPROVED

[Service]
Type=oneshot
User=sitesourcery-monitor
Group=sitesourcery-monitor
WorkingDirectory=/opt/sitesourcery/current
EnvironmentFile=/etc/sitesourcery/probe.env
ExecStart=/opt/sitesourcery/node-24.18.0/bin/node /opt/sitesourcery/current/ops/probe-runtime.mjs
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

# Clean-room restore only. Copy to a disposable host with mode 0600.
# Never point these values at the production database or production data root.
SITESOURCERY_STRIPE_MODE=held
SITESOURCERY_REGISTRATION_MAIL_MODE=held
SITESOURCERY_RECOVERY_MAIL_MODE=held
SITESOURCERY_EXPECT_PUBLICATION=held
SITESOURCERY_EXPECT_DOMAIN_RUNTIME=held
SITESOURCERY_EXPECT_DNS=held
SITESOURCERY_ALERT_MODE=held
SITESOURCERY_RESTORE_BACKUP_ATTEMPT=/mnt/sitesourcery-backups/attempts/replace-with-attempt
SITESOURCERY_RESTORE_STAGING_ROOT=/var/lib/sitesourcery-restore/staging
SITESOURCERY_RESTORE_EVIDENCE_ROOT=/var/lib/sitesourcery-restore/evidence
SITESOURCERY_RESTORE_APP_ROOT=/var/lib/sitesourcery-restore/app-state
SITESOURCERY_RESTORE_AGE_IDENTITY_FILE=/etc/sitesourcery-restore/backup.age-identity
SITESOURCERY_RESTORE_ADMIN_DATABASE_URL=replace-with-disposable-admin-secret
SITESOURCERY_RESTORE_DATABASE_NAME=sitesourcery_restore_replace_me

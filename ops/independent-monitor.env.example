# Candidate configuration only. The committed mode is held and performs no
# network or provider effect. A separate bounded approval file and marker are
# required before changing this value to approved_read_only.
SITESOURCERY_INDEPENDENT_MONITOR_MODE=held
SITESOURCERY_OPERATIONS_PROVIDER_EGRESS=held
SITESOURCERY_RELEASE_EPOCH_FILE=/opt/sitesourcery-monitor/current/ops/releases/shape-epoch-2026-08-10/release-epoch.json
SITESOURCERY_INDEPENDENT_APEX_URL=https://sitesourcery.com/
SITESOURCERY_INDEPENDENT_CONTENT_URL=https://sitesourcery.com/legal/privacy/versions/SS-HOSTED-PRIVACY-2026-08-09-V4/
SITESOURCERY_INDEPENDENT_TUNNEL_URL=https://sitesourcery.com/api/v1/health
SITESOURCERY_INDEPENDENT_TLS_HOSTNAME=sitesourcery.com
SITESOURCERY_INDEPENDENT_TLS_PORT=443
SITESOURCERY_INDEPENDENT_TIMEOUT_MS=3000
SITESOURCERY_INDEPENDENT_TLS_MIN_VALIDITY_MS=1814400000
SITESOURCERY_INDEPENDENT_HEARTBEAT_FILE=/var/lib/sitesourcery-independent-monitor/current.json
# SITESOURCERY_INDEPENDENT_MONITOR_APPROVAL_FILE=/etc/sitesourcery-independent-monitor/monitor-approved.json

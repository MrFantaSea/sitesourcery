{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitesourcery.com/schemas/credential-topology-v1.json",
  "title": "Site Sourcery held credential topology",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "items"],
  "properties": {
    "schema": {
      "const": "sitesourcery.credential-topology/v1"
    },
    "mode": {
      "const": "held"
    },
    "items": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceDigest",
        "kind",
        "lastProvenAt",
        "materialPresent",
        "name",
        "purpose",
        "providerBinding",
        "rotationState",
        "scopes",
        "storageBoundary"
      ],
      "properties": {
        "evidenceDigest": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "kind": {
          "enum": [
            "backup_decryption_identity",
            "encrypted_backup_material",
            "identity_pepper",
            "operator_recovery_authority",
            "provider_api_environment_bound",
            "provider_api_restricted",
            "provider_api_shared_status",
            "provider_api_standard_status",
            "provider_customer_registry",
            "provider_tunnel_credential",
            "provider_webhook_signing",
            "rotation_control",
            "separation_control",
            "symmetric_encryption_key"
          ]
        },
        "lastProvenAt": {
          "anyOf": [
            { "$ref": "#/$defs/instant" },
            { "type": "null" }
          ]
        },
        "materialPresent": {
          "type": "boolean"
        },
        "name": {
          "enum": [
            "backup.age.ciphertext.primary",
            "backup.age.identity.recovery",
            "cloudflare.tunnel.production.connector",
            "control.backup.identity-ciphertext.separation",
            "control.identity.pepper.rotation",
            "control.operator.recovery.dual-control",
            "control.resend.environment-separation",
            "control.responder.material.rotation",
            "control.stripe.webhook.rotation",
            "control.twilio.customer-isolation",
            "identity.pepper.production.current",
            "identity.pepper.production.prior",
            "operator.recovery.approver",
            "operator.recovery.requester",
            "registrant.contact.production.encryption",
            "resend.sender.historical-shared-full-access",
            "resend.sender.production.restricted",
            "resend.sender.staging.restricted",
            "responder.material.production.current",
            "responder.material.production.prior",
            "stripe.provisioner.production.restricted",
            "stripe.runtime.production.restricted",
            "stripe.standard.production.compromised",
            "stripe.webhook.production.current",
            "stripe.webhook.production.prior",
            "twilio.responder.production.api.restricted",
            "twilio.responder.production.webhook.signature"
          ]
        },
        "purpose": {
          "enum": [
            "backup_identity_ciphertext_separation",
            "backup_recovery_source",
            "backup_restore_decryption",
            "cloudflare_tunnel_origin_authentication",
            "compromised_credential_status_only",
            "credential_recovery_approval",
            "credential_recovery_request",
            "identity_current_derivation",
            "identity_pepper_overlap_or_revocation",
            "identity_prior_verification",
            "operator_recovery_dual_control",
            "registrant_contact_encryption",
            "resend_production_delivery",
            "resend_production_staging_separation",
            "resend_staging_delivery",
            "responder_material_current_encryption",
            "responder_material_overlap_or_revocation",
            "responder_material_prior_decryption",
            "shared_full_access_credential_status_only",
            "stripe_ephemeral_provisioning_status",
            "stripe_runtime_production",
            "stripe_webhook_current_verification",
            "stripe_webhook_overlap_or_revocation",
            "stripe_webhook_prior_overlap",
            "twilio_responder_delivery",
            "twilio_customer_runtime_authority",
            "twilio_customer_subaccount_isolation",
            "twilio_responder_webhook_verification"
          ]
        },
        "providerBinding": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/stripeRuntimeBinding" },
            { "$ref": "#/$defs/stripeProvisionerBinding" },
            { "$ref": "#/$defs/stripeStandardBinding" }
          ]
        },
        "rotationState": {
          "enum": [
            "active",
            "compromised_pending_revocation",
            "compromised_revoked",
            "ephemeral_revoked",
            "overlap",
            "proven",
            "revoked",
            "shared_pending_revocation",
            "shared_revoked",
            "unproven"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "age:ciphertext",
              "age:decrypt",
              "backup.age.ciphertext.primary",
              "backup.age.identity.recovery",
              "billing_portal_configurations:read",
              "billing_portal_configurations:write",
              "billing_portal_sessions:write",
              "charges:read",
              "checkout_sessions:write",
              "coupons:read",
              "coupons:write",
              "customers:write",
              "disputes:read",
              "domains:read",
              "emails:send",
              "identity.pepper.production.current",
              "identity.pepper.production.prior",
              "identity:derive-current",
              "identity:verify-prior",
              "invoices:read",
              "operator.recovery.approver",
              "operator.recovery.requester",
              "prices:read",
              "prices:write",
              "products:read",
              "products:write",
              "recovery:approve",
              "recovery:request",
              "registrant:decrypt",
              "registrant:encrypt",
              "resend.sender.production.restricted",
              "resend.sender.staging.restricted",
              "responder.material.production.current",
              "responder.material.production.prior",
              "responder-material:decrypt",
              "responder-material:decrypt-prior",
              "responder-material:encrypt",
              "refunds:read",
              "status:revocation-only",
              "stripe.webhook.production.current",
              "stripe.webhook.production.prior",
              "subscription_schedules:write",
              "subscriptions:write",
              "tax_registrations:write",
              "tax_settings:write",
              "tunnel:connect",
              "twilio-account:read",
              "twilio-messaging-compliance:read",
              "twilio-messages:send",
              "twilio-webhooks:verify",
              "webhook_endpoints:read",
              "webhook_endpoints:write",
              "webhooks:verify",
              "webhooks:verify-prior"
            ]
          }
        },
        "storageBoundary": {
          "enum": [
            "dell-cloudflare-tunnel-secret-store",
            "dell-hosted-production-secret-store",
            "immutable-nonsecret-ops-evidence-ledger",
            "independent-off-zen-recovery-custody",
            "operator-ephemeral-provider-session",
            "operator-recovery-approver-custody",
            "operator-recovery-requester-custody",
            "provider-control-plane-status-only",
            "staging-mail-secret-store",
            "zen-off-machine-ciphertext-store"
          ]
        }
      }
    },
    "stripeRuntimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "activatedAt",
        "enabledPurposes",
        "environment",
        "keyClass",
        "keyFingerprint",
        "keyVersion",
        "livemode",
        "provider"
      ],
      "properties": {
        "accountId": { "type": "string", "pattern": "^acct_[A-Za-z0-9_]{1,250}$" },
        "activatedAt": { "$ref": "#/$defs/instant" },
        "enabledPurposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "alakazam",
              "customBuildChange",
              "customBuildFinal",
              "customBuildStart",
              "download",
              "serviceAssessment"
            ]
          }
        },
        "environment": { "const": "production" },
        "keyClass": { "const": "restricted" },
        "keyFingerprint": { "$ref": "#/$defs/sha256" },
        "keyVersion": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,200}$" },
        "livemode": { "const": true },
        "provider": { "const": "stripe" }
      }
    },
    "stripeProvisionerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "activatedAt",
        "environment",
        "keyClass",
        "keyFingerprint",
        "keyVersion",
        "livemode",
        "provider",
        "revokedAt",
        "scopeEvidenceDigest",
        "scopeProvenAt"
      ],
      "properties": {
        "accountId": { "type": "string", "pattern": "^acct_[A-Za-z0-9_]{1,250}$" },
        "activatedAt": { "$ref": "#/$defs/instant" },
        "environment": { "const": "production" },
        "keyClass": { "const": "restricted" },
        "keyFingerprint": { "$ref": "#/$defs/sha256" },
        "keyVersion": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,200}$" },
        "livemode": { "const": true },
        "provider": { "const": "stripe" },
        "revokedAt": { "$ref": "#/$defs/instant" },
        "scopeEvidenceDigest": { "$ref": "#/$defs/sha256" },
        "scopeProvenAt": { "$ref": "#/$defs/instant" }
      }
    },
    "stripeStandardBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "environment",
        "keyClass",
        "keyFingerprint",
        "keyVersion",
        "livemode",
        "provider",
        "revokedAt"
      ],
      "properties": {
        "accountId": { "type": "string", "pattern": "^acct_[A-Za-z0-9_]{1,250}$" },
        "environment": { "const": "production" },
        "keyClass": { "const": "standard_status_only" },
        "keyFingerprint": { "$ref": "#/$defs/sha256" },
        "keyVersion": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,200}$" },
        "livemode": { "const": true },
        "provider": { "const": "stripe" },
        "revokedAt": { "$ref": "#/$defs/instant" }
      }
    }
  }
}

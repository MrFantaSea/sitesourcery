# Copy to /etc/sitesourcery/monitor.env with mode 0600.
# Outbound delivery remains held. This file contains no destination or token.
# A separately reviewed deployment may use reviewed_resend with a private
# approval file, recipient, destination identity, and persistent state path.
SITESOURCERY_ALERT_MODE=held
SITESOURCERY_STRIPE_MODE=held
SITESOURCERY_REGISTRATION_MAIL_MODE=held
SITESOURCERY_RECOVERY_MAIL_MODE=held
SITESOURCERY_EXPECT_PUBLICATION=held
SITESOURCERY_EXPECT_DOMAIN_RUNTIME=held
SITESOURCERY_EXPECT_DNS=held
SITESOURCERY_OPERATIONS_PROVIDER_EGRESS=held
# Leave unset for the exact default-held state. Any non-held source state
# requires a bounded reviewed document at this absolute path.
# SITESOURCERY_OPERATIONS_STATE_APPROVAL_FILE=/etc/sitesourcery/operations-state-approved.json
SITESOURCERY_SOURCE_FAILURE_DOMAIN=replace-with-primary-failure-domain
SITESOURCERY_DATABASE_URL=replace-with-root-owned-readonly-monitor-secret
SITESOURCERY_DATA_ROOT=/var/lib/sitesourcery
SITESOURCERY_HOSTED_PORT=8788
SITESOURCERY_TENANT_PORT=8080
SITESOURCERY_BACKUP_DESTINATION_ROOT=/mnt/sitesourcery-backups
# Leave certificate fields unset while publication and DNS are both exactly
# held. They become mandatory as soon as either public-edge state is approved.
# SITESOURCERY_MONITOR_CERTIFICATE_FILE=/var/lib/caddy/certificates/replace-with-public-certificate.pem
# SITESOURCERY_MONITOR_CERTIFICATE_HOSTNAME=replace-with-reviewed-control-host
SITESOURCERY_MONITOR_TIMEOUT_MS=10000
SITESOURCERY_MONITOR_BACKUP_MAX_AGE_MS=93600000
SITESOURCERY_MONITOR_DISK_MIN_FREE_BYTES=5368709120
# Optional explicit volume coverage replaces the legacy data-root-only disk
# check. Each volume must meet BOTH its own byte and ratio reserve. Unset keeps
# the legacy 5 GiB / 20% defaults above; malformed/empty lists fail closed.
# HQ reserves: protected 2 GiB / 20%, root 30 GiB / 3%. These report capacity
# warnings through the existing disk alert; they never delete or purge data.
# SITESOURCERY_MONITOR_DISK_VOLUMES_JSON='[{"name":"protected","path":"/srv/sitesourcery-storage","minimumFreeBytes":2147483648,"minimumFreeRatio":0.2},{"name":"root","path":"/","minimumFreeBytes":32212254720,"minimumFreeRatio":0.03}]'
SITESOURCERY_MONITOR_CERT_MIN_VALIDITY_MS=1814400000

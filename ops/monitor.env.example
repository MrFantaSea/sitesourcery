# Copy to /etc/sitesourcery/monitor.env with mode 0600.
# Outbound delivery remains held. This file contains no destination or token.
SITESOURCERY_ALERT_MODE=held
SITESOURCERY_STRIPE_MODE=held
SITESOURCERY_RECOVERY_MAIL_MODE=held
SITESOURCERY_EXPECT_PUBLICATION=held
SITESOURCERY_EXPECT_DOMAIN_RUNTIME=held
SITESOURCERY_EXPECT_DNS=held
SITESOURCERY_SOURCE_FAILURE_DOMAIN=replace-with-primary-failure-domain
SITESOURCERY_DATABASE_URL=replace-with-root-owned-readonly-monitor-secret
SITESOURCERY_DATA_ROOT=/var/lib/sitesourcery
SITESOURCERY_HOSTED_PORT=8788
SITESOURCERY_TENANT_PORT=8080
SITESOURCERY_BACKUP_DESTINATION_ROOT=/mnt/sitesourcery-backups
SITESOURCERY_MONITOR_CERTIFICATE_FILE=/var/lib/caddy/certificates/replace-with-public-certificate.pem
SITESOURCERY_MONITOR_CERTIFICATE_HOSTNAME=replace-with-reviewed-control-host
SITESOURCERY_MONITOR_TIMEOUT_MS=3000
SITESOURCERY_MONITOR_BACKUP_MAX_AGE_MS=93600000
SITESOURCERY_MONITOR_DISK_MIN_FREE_BYTES=5368709120
SITESOURCERY_MONITOR_CERT_MIN_VALIDITY_MS=1814400000

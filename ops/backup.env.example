# Copy to /etc/sitesourcery/backup.env with mode 0600.
# This example is inert. Secret values belong only in the real root-owned file.
SITESOURCERY_STRIPE_MODE=held
SITESOURCERY_REGISTRATION_MAIL_MODE=held
SITESOURCERY_RECOVERY_MAIL_MODE=held
SITESOURCERY_EXPECT_PUBLICATION=held
SITESOURCERY_EXPECT_DOMAIN_RUNTIME=held
SITESOURCERY_EXPECT_DNS=held
SITESOURCERY_OPERATIONS_PROVIDER_EGRESS=held
# Leave unset for the exact default-held state. Any non-held source state
# requires a bounded reviewed document at this absolute path.
# SITESOURCERY_OPERATIONS_STATE_APPROVAL_FILE=/etc/sitesourcery/operations-state-approved.json
SITESOURCERY_SOURCE_FAILURE_DOMAIN=replace-with-primary-failure-domain
SITESOURCERY_BACKUP_DESTINATION_ROOT=/mnt/sitesourcery-backups
SITESOURCERY_BACKUP_STAGING_ROOT=/var/lib/sitesourcery/backup-staging
SITESOURCERY_BACKUP_AGE_RECIPIENT_FILE=/etc/sitesourcery/backup.age-recipients
SITESOURCERY_BACKUP_QUIESCE_PATH=/run/sitesourcery/BACKUP_QUIESCE
SITESOURCERY_BACKUP_RETENTION_APPLY=false
SITESOURCERY_BACKUP_RETENTION_MAX_AGE_MS=2592000000
SITESOURCERY_BACKUP_RETENTION_MINIMUM_SUCCESSFUL=7
SITESOURCERY_DATA_ROOT=/var/lib/sitesourcery
SITESOURCERY_EXPORT_ROOT=/var/lib/sitesourcery/private-exports
SITESOURCERY_RELEASE_ROOT=/opt/sitesourcery/current
SITESOURCERY_CONFIGURATION_ROOT=/etc/sitesourcery
SITESOURCERY_DATABASE_URL=replace-with-root-owned-secret

[Unit]
Description=Site Sourcery immutable held production artifact rehearsal
After=network-online.target sitesourcery-production.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/simtech/sitesourcery-production/releases/74da288776ab43770a44a9708ee1e0ef590b0371/_hosted
ExecStart=/usr/bin/python3 -m http.server 8899 --bind 127.0.0.1 --directory /home/simtech/sitesourcery-production/releases/74da288776ab43770a44a9708ee1e0ef590b0371/_hosted
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target

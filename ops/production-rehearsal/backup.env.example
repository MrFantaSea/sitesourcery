# Exact non-secret environment for the Dell production-rehearsal backup.
# The one-shot unit loads hosted.env first so the existing private database URL
# stays in its mode-0600 source file; this file deliberately contains no secret.
SITESOURCERY_STRIPE_MODE=held
SITESOURCERY_REGISTRATION_MAIL_MODE=production
SITESOURCERY_RECOVERY_MAIL_MODE=production
SITESOURCERY_EXPECT_PUBLICATION=held
SITESOURCERY_EXPECT_DOMAIN_RUNTIME=held
SITESOURCERY_EXPECT_DNS=held
SITESOURCERY_OPERATIONS_PROVIDER_EGRESS=held
SITESOURCERY_OPERATIONS_STATE_APPROVAL_FILE=/home/simtech/sitesourcery-production/run/operations-state-approved.json
SITESOURCERY_SOURCE_FAILURE_DOMAIN=dell-sitesourcery-production-01
SITESOURCERY_BACKUP_DESTINATION_ROOT=/home/simtech/sitesourcery-production/off-machine
SITESOURCERY_BACKUP_STAGING_ROOT=/home/simtech/sitesourcery-production/backup-staging
SITESOURCERY_BACKUP_AGE_RECIPIENT_FILE=/home/simtech/sitesourcery-production/run/backup.age-recipient
SITESOURCERY_BACKUP_QUIESCE_PATH=/run/user/1000/sitesourcery-production/BACKUP_QUIESCE
SITESOURCERY_DATA_ROOT=/home/simtech/sitesourcery-production/state
SITESOURCERY_EXPORT_ROOT=/home/simtech/sitesourcery-production/state/private-exports
SITESOURCERY_RELEASE_ROOT=/home/simtech/sitesourcery-production/backup-release/15cab8f4d220f9a5116b89c732daa6dc9fb19a17
SITESOURCERY_CONFIGURATION_ROOT=/home/simtech/sitesourcery-production/run
PATH=/home/simtech/sitesourcery-production/toolchain/age-v1.3.1:/home/simtech/sitesourcery-production/toolchain/postgresql-client-16.14/usr/lib/postgresql/16/bin:/home/simtech/sitesourcery-production/toolchain/node-v24.18.0-linux-x64/bin:/usr/bin:/bin
LD_LIBRARY_PATH=/home/simtech/sitesourcery-production/toolchain/postgresql-client-16.14/usr/lib/x86_64-linux-gnu

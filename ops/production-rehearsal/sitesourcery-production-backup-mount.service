[Unit]
Description=Site Sourcery production off-machine backup mount
After=network-online.target
Wants=network-online.target
Before=sitesourcery-production-backup.service sitesourcery-production-monitor.service
ConditionPathIsDirectory=/home/simtech/sitesourcery-production/off-machine
ConditionPathExists=/home/simtech/sitesourcery-production/toolchain/sshfs-3.7.3/usr/bin/sshfs
ConditionPathExists=/home/simtech/.ssh/id_ed25519_fantasea_mesh
ConditionPathExists=/home/simtech/.ssh/known_hosts

[Service]
Type=simple
ExecStart=/home/simtech/sitesourcery-production/toolchain/sshfs-3.7.3/usr/bin/sshfs -f zen:/home/zentech/.local/state/sitesourcery-backups /home/simtech/sitesourcery-production/off-machine -o ssh_command=/usr/bin/ssh -o IdentityFile=/home/simtech/.ssh/id_ed25519_fantasea_mesh -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/home/simtech/.ssh/known_hosts -o reconnect -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o default_permissions -o noexec -o nodev -o nosuid
ExecStartPost=/usr/bin/sleep 1
ExecStartPost=/usr/bin/mountpoint -q /home/simtech/sitesourcery-production/off-machine
ExecStartPost=/usr/bin/test -f /home/simtech/sitesourcery-production/off-machine/.sitesourcery-off-machine.json
ExecStop=-/usr/bin/fusermount3 -u /home/simtech/sitesourcery-production/off-machine
Restart=on-failure
RestartSec=10
TimeoutStartSec=45
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077

# A FUSE provider must publish this mount into the user manager's namespace.
# Filesystem namespace hardening directives would make the mount private to
# this service and are therefore deliberately absent. The process still runs
# as the unprivileged Dell service user with a pinned command, key, host file,
# destination, service UMask, private mount directory, default permission
# checks, and restrictive FUSE options. An SSHFS umask override is deliberately
# absent because it would make immutable remote mode 0440 evidence appear
# locally writable as mode 0700. Address-family filtering is also absent
# because SSHFS/FUSE performs setup outside the eventual SSH data sockets and
# must complete before the mount can be published.

[Install]
WantedBy=default.target

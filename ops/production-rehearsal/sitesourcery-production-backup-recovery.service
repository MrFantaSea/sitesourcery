[Unit]
Description=Recover an interrupted Site Sourcery production-rehearsal backup
After=sitesourcery-production.service
ConditionPathExists=/home/simtech/sitesourcery-production/run/hosted.env
ConditionPathExists=/home/simtech/sitesourcery-production/run/backup.env
ConditionPathIsDirectory=/home/simtech/sitesourcery-production/backup-staging

[Service]
Type=oneshot
WorkingDirectory=/home/simtech/sitesourcery-production/releases/70d270fd8ffb242fe80db265d61a74dd4bbdfad2
Environment=NODE_ENV=production
EnvironmentFile=/home/simtech/sitesourcery-production/run/hosted.env
EnvironmentFile=/home/simtech/sitesourcery-production/run/backup.env
ExecStart=/usr/bin/flock --exclusive --wait 120 --conflict-exit-code 75 --no-fork %t/sitesourcery-production-operations.lock /home/simtech/sitesourcery-production/toolchain/node-v24.18.0-linux-x64/bin/node /home/simtech/sitesourcery-production/releases/70d270fd8ffb242fe80db265d61a74dd4bbdfad2/ops/run-production-rehearsal-backup-cycle.mjs recover
UMask=0077
TimeoutStartSec=3m

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target

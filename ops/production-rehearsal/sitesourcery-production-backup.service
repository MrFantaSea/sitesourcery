[Unit]
Description=One encrypted off-machine Site Sourcery production-rehearsal backup
ConditionPathIsMountPoint=/home/simtech/sitesourcery-production/off-machine
ConditionPathExists=/home/simtech/sitesourcery-production/off-machine/.sitesourcery-off-machine.json
ConditionPathExists=%t/sitesourcery-production/BACKUP_QUIESCE

[Service]
Type=oneshot
WorkingDirectory=/home/simtech/sitesourcery-production/releases/15cab8f4d220f9a5116b89c732daa6dc9fb19a17
Environment=NODE_ENV=production
EnvironmentFile=/home/simtech/sitesourcery-production/run/hosted.env
EnvironmentFile=/home/simtech/sitesourcery-production/run/backup.env
ExecStart=/home/simtech/sitesourcery-production/toolchain/node-v24.18.0-linux-x64/bin/node /home/simtech/sitesourcery-production/releases/15cab8f4d220f9a5116b89c732daa6dc9fb19a17/ops/run-production-rehearsal-backup.mjs
UMask=0077
TimeoutStartSec=2h

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

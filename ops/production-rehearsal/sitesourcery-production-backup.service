[Unit]
Description=Supervised encrypted Site Sourcery production-rehearsal backup cycle
After=sitesourcery-production.service sitesourcery-production-backup-mount.service
Requires=sitesourcery-production-backup-mount.service
ConditionPathIsMountPoint=/home/simtech/sitesourcery-production/off-machine
ConditionPathExists=/home/simtech/sitesourcery-production/off-machine/.sitesourcery-off-machine.json

[Service]
Type=oneshot
WorkingDirectory=/home/simtech/sitesourcery-production/releases/70d270fd8ffb242fe80db265d61a74dd4bbdfad2
Environment=NODE_ENV=production
EnvironmentFile=/home/simtech/sitesourcery-production/run/hosted.env
EnvironmentFile=/home/simtech/sitesourcery-production/run/backup.env
ExecStart=/usr/bin/flock --exclusive --wait 120 --conflict-exit-code 75 --no-fork %t/sitesourcery-production-operations.lock /home/simtech/sitesourcery-production/toolchain/node-v24.18.0-linux-x64/bin/node /home/simtech/sitesourcery-production/releases/70d270fd8ffb242fe80db265d61a74dd4bbdfad2/ops/run-production-rehearsal-backup-cycle.mjs run
ExecStopPost=/usr/bin/flock --exclusive --wait 120 --conflict-exit-code 75 --no-fork %t/sitesourcery-production-operations.lock /home/simtech/sitesourcery-production/toolchain/node-v24.18.0-linux-x64/bin/node /home/simtech/sitesourcery-production/releases/70d270fd8ffb242fe80db265d61a74dd4bbdfad2/ops/run-production-rehearsal-backup-cycle.mjs recover
UMask=0077
TimeoutStartSec=30m
TimeoutStopSec=3m
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

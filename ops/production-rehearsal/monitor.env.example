# Exact non-secret environment for the Dell production-rehearsal monitor.
# The one-shot unit loads hosted.env first for the existing private database
# URL and Resend credentials. Outbound alerts stay held until the private
# operations inbox and a bounded approval file are both confirmed.
SITESOURCERY_ALERT_MODE=held
SITESOURCERY_STRIPE_MODE=held
SITESOURCERY_REGISTRATION_MAIL_MODE=production
SITESOURCERY_RECOVERY_MAIL_MODE=production
SITESOURCERY_EXPECT_PUBLICATION=held
SITESOURCERY_EXPECT_DOMAIN_RUNTIME=held
SITESOURCERY_EXPECT_DNS=held
SITESOURCERY_OPERATIONS_PROVIDER_EGRESS=held
SITESOURCERY_OPERATIONS_STATE_APPROVAL_FILE=/home/simtech/sitesourcery-production/run/operations-state-approved.json
SITESOURCERY_SOURCE_FAILURE_DOMAIN=dell-sitesourcery-production-01
SITESOURCERY_DATA_ROOT=/home/simtech/sitesourcery-production/state
SITESOURCERY_HOSTED_PORT=8788
SITESOURCERY_TENANT_PORT=8080
SITESOURCERY_BACKUP_DESTINATION_ROOT=/home/simtech/sitesourcery-production/off-machine
SITESOURCERY_MONITOR_TIMEOUT_MS=3000
SITESOURCERY_MONITOR_BACKUP_MAX_AGE_MS=93600000
SITESOURCERY_MONITOR_DISK_MIN_FREE_BYTES=5368709120
SITESOURCERY_MONITOR_CERT_MIN_VALIDITY_MS=1814400000
SITESOURCERY_ALERT_REPEAT_INTERVAL_MS=21600000

# Configure these only in the real mode-0600 file when switching to the
# separately reviewed alert path. The recipient is private and never belongs
# in Git. The certificate fields stay absent while publication and DNS are
# both exactly held.
# SITESOURCERY_ALERT_APPROVAL_FILE=/home/simtech/sitesourcery-production/run/monitor-alert-approved.json
# SITESOURCERY_ALERT_STATE_FILE=/home/simtech/sitesourcery-production/state/operations-monitor/current.json
# SITESOURCERY_ALERT_ADAPTER_ID=replace-with-reviewed-adapter-id
# SITESOURCERY_ALERT_DESTINATION_REF=replace-with-reviewed-destination-reference
# SITESOURCERY_ALERT_RECIPIENT=replace-with-private-operations-inbox

# ACTIVATION_HOLD — independent observer candidate only. Do not copy, enable, or start.

[Unit]
Description=Observe Site Sourcery public edge without origin or backup dependencies
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/sitesourcery-independent-monitor/MONITOR_APPROVED
ConditionPathExists=/etc/sitesourcery-independent-monitor/monitor-approved.json

[Service]
Type=oneshot
User=sitesourcery-monitor
Group=sitesourcery-monitor
WorkingDirectory=/opt/sitesourcery-monitor/current
EnvironmentFile=/etc/sitesourcery-independent-monitor/monitor.env
ExecStart=/opt/sitesourcery-monitor/node-24.18.0/bin/node /opt/sitesourcery-monitor/current/ops/independent-monitor.mjs
UMask=0077
TimeoutStartSec=45s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

ReadOnlyPaths=/opt/sitesourcery-monitor/current /etc/sitesourcery-independent-monitor
ReadWritePaths=/var/lib/sitesourcery-independent-monitor

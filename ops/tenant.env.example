# Copy to /etc/sitesourcery/tenant.env with mode 0600. This read-only process
# receives no database, provider, worker, or publication-command credential.
SITESOURCERY_TENANT_HOST=127.0.0.1
SITESOURCERY_TENANT_PORT=8080
SITESOURCERY_DATA_ROOT=/var/lib/sitesourcery/tenant-runtime
SITESOURCERY_CONTROL_HOST=127.0.0.1
SITESOURCERY_LICENSED_BASE_DOMAIN=sites.example.invalid
SITESOURCERY_MAX_FILE_BYTES=10485760
SITESOURCERY_MAX_RELEASE_BYTES=104857600
SITESOURCERY_RELEASE_EPOCH_FILE=/etc/sitesourcery/final-release-epoch-v2.json
SITESOURCERY_RELEASE_EPOCH_SHA256=replace-with-exact-file-sha256
SITESOURCERY_ORIGIN_SEAL_FILE=/etc/sitesourcery/origin-seal.json
SITESOURCERY_ORIGIN_SEAL_FILE_SHA256=replace-with-exact-file-sha256
SITESOURCERY_ORIGIN_INSTALLED_READBACK_FILE=/etc/sitesourcery/origin-installed-readback.json
SITESOURCERY_ORIGIN_INSTALLED_READBACK_FILE_SHA256=replace-with-exact-file-sha256

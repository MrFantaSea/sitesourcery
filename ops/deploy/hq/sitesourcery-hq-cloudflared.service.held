# HELD: installing this template does not authorize a public tunnel.
[Unit]
Description=Site Sourcery HQ outbound Cloudflare tunnel
After=network-online.target sitesourcery-hq-gateway.service
Requires=sitesourcery-hq-gateway.service
Wants=network-online.target
ConditionPathExists=/etc/sitesourcery/CLOUDFLARE_TUNNEL_APPROVED
ConditionPathExists=/etc/sitesourcery/cloudflared.json
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=mrfantasea
Group=mrfantasea
ExecStartPre=/usr/bin/curl --fail --silent --show-error --max-time 15 -H Host:sitesourcery.com http://127.0.0.1:8081/
ExecStart=/home/mrfantasea/.local/bin/cloudflared tunnel --config /etc/sitesourcery/cloudflared.yml --no-autoupdate --metrics 127.0.0.1:20241 --loglevel info run 211ffa61-e170-444d-a945-04fead19c972
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target

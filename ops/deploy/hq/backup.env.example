# HELD HQ backup boundary. Load hosted.env first; never copy secret values here.
# Before activation root must create private owner directories, mount and verify
# the existing separate-machine destination, install exact polkit/user fences,
# and bind configuration/release archives plus the operations-state approval.
SITESOURCERY_SOURCE_FAILURE_DOMAIN=hq-sitesourcery-production-01
SITESOURCERY_BACKUP_DESTINATION_ROOT=/home/mrfantasea/.local/share/sitesourcery-production/off-machine
SITESOURCERY_BACKUP_STAGING_ROOT=/srv/sitesourcery-storage/production/backup-staging
SITESOURCERY_BACKUP_AGE_RECIPIENT_FILE=/etc/sitesourcery/backup.age-recipient
SITESOURCERY_BACKUP_QUIESCE_PATH=/srv/sitesourcery-storage/production/backup-control/BACKUP_QUIESCE
SITESOURCERY_DATA_ROOT=/srv/sitesourcery-storage/production/app
SITESOURCERY_EXPORT_ROOT=/srv/sitesourcery-storage/production/app/private-exports
SITESOURCERY_RELEASE_ROOT=/home/mrfantasea/.local/share/sitesourcery-production/current
# R4 must stage the immutable private HQ identity.json with private custody at
# /etc/sitesourcery/recovery/private-hq/ before activation. Restore it to the
# guarded owner directory; the existing provisioner regenerates the session.
# /active/operator and /active/hq are not implicitly archived by this setting.
SITESOURCERY_CONFIGURATION_ROOT=/etc/sitesourcery
SITESOURCERY_OPERATIONS_PROVIDER_EGRESS=held
SITESOURCERY_OPERATIONS_STATE_APPROVAL_FILE=/etc/sitesourcery/operations-state-approved.json
PATH=/home/mrfantasea/.local/opt/sitesourcery/age-v1.3.1:/home/mrfantasea/.local/opt/sitesourcery-postgresql-16.14/usr/lib/postgresql/16/bin:/home/mrfantasea/.local/opt/sitesourcery/node-v24.18.0/bin:/usr/bin:/bin
LD_LIBRARY_PATH=/home/mrfantasea/.local/opt/sitesourcery-postgresql-16.14/usr/lib/x86_64-linux-gnu

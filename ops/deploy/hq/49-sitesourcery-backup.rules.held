// HELD CANDIDATE: root installs this exact file as root:root, mode 0644.
// No wildcard units, restart, enable, reload, transient units or root JS entrypoint.
polkit.addRule(function(action, subject) {
  if (subject.user === "mrfantasea" &&
      action.id === "org.freedesktop.systemd1.manage-units" &&
      ["sitesourcery-hq-api.service", "sitesourcery-hq-workers.service"].indexOf(action.lookup("unit")) !== -1 &&
      ["start", "stop"].indexOf(action.lookup("verb")) !== -1) {
    return polkit.Result.YES;
  }
});

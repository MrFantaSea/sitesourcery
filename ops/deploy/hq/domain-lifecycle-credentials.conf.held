# HELD: install only for the separately approved domain-lifecycle readback.
# systemd >=250 decrypts a root-custodied encrypted credential at unit start.
# API key permissions must be ONLY domains:read. Never put credentials in env.
# This does not add domain-lifecycle to the worker purpose allowlist or enable it.
[Service]
LoadCredentialEncrypted=spaceship-domain-readonly.json:/etc/sitesourcery/domain/spaceship-domain-readonly.cred

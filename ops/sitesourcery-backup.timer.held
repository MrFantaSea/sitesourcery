# PUBLICATION_HOLD — template only. Do not copy, enable, or start.

[Unit]
Description=Offer a daily held Site Sourcery backup attempt
ConditionPathExists=/etc/sitesourcery/BACKUP_APPROVED
ConditionPathExists=/etc/sitesourcery/PUBLICATION_HOLD

[Timer]
OnCalendar=*-*-* 04:17:00
RandomizedDelaySec=15m
Persistent=true
Unit=sitesourcery-backup.service

[Install]
WantedBy=timers.target

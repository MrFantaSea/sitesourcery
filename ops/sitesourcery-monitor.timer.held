# ACTIVATION_HOLD — template only. Do not copy, enable, or start.

[Unit]
Description=Offer the Site Sourcery operations monitor every minute
ConditionPathExists=/etc/sitesourcery/RUNTIME_APPROVED

[Timer]
OnBootSec=2m
OnUnitActiveSec=1m
AccuracySec=5s
RandomizedDelaySec=5s
Persistent=true
Unit=sitesourcery-monitor.service

[Install]
WantedBy=timers.target

# ACTIVATION_HOLD — independent observer candidate only. Do not copy, enable, or start.

[Unit]
Description=Offer the independent Site Sourcery edge monitor every minute
ConditionPathExists=/etc/sitesourcery-independent-monitor/MONITOR_APPROVED

[Timer]
OnBootSec=2m
OnUnitActiveSec=1m
AccuracySec=5s
RandomizedDelaySec=5s
Persistent=true
Unit=sitesourcery-monitor.service

[Install]
WantedBy=timers.target

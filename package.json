{
  "name": "site-sourcery",
  "version": "0.0.0",
  "description": "Site Sourcery customer site and held self-hosted product runtime.",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "runtime:check": "node server/domain/assert-runtime.mjs",
    "runtime:selfhost": "node server/selfhost/bin/assert-runtime.mjs",
    "runtime:hosted-service": "node server/hosted/assert-runtime.mjs",
    "readiness:spaceship": "node server/domain/spaceship-readiness.mjs",
    "generate:vnext": "node scripts/generate-site-vnext.mjs",
    "audit:browser": "node --experimental-websocket scripts/browser-audit-current.mjs",
    "audit:browser:legacy": "node --experimental-websocket scripts/browser-audit-vnext.mjs",
    "audit:hosted-domain-browser:legacy": "node --experimental-websocket scripts/browser-hosted-domain-journey.mjs",
    "check": "npm run check:html && npm run check:site",
    "check:site": "node scripts/check-site.mjs",
    "check:legacy": "npm run check:routes && npm run check:vnext && npm run check:sections && npm run check:copy && npm run check:legal-copy && npm run check:catalog && npm run check:abracadabra && npm run check:hosted",
    "check:html": "html-validate \"*.html\" \"**/index.html\" \"!node_modules/**\" \"!_site/**\" \"!_hosted/**\"",
    "check:routes": "node scripts/check-routes.mjs",
    "check:vnext": "node scripts/check-site-vnext.mjs",
    "check:sections": "node scripts/check-customer-section-ledger.mjs",
    "check:copy": "node scripts/check-customer-copy.mjs",
    "check:legal-copy": "node scripts/check-legal-copy.mjs",
    "check:catalog": "node scripts/check-pricing.mjs",
    "check:abracadabra": "node scripts/check-abracadabra-v1.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "check:hosted": "node scripts/build-hosted.mjs && html-validate \"_hosted/**/*.html\"",
    "test:node": "node --test scripts/test/abracadabra-v1.test.mjs scripts/test/abracadabra-unload-guard.test.mjs scripts/test/abracadabra-platform.test.mjs scripts/test/abracadabra-api.test.mjs scripts/test/abracadabra-commercial-control.test.mjs scripts/test/abracadabra-hosted-control.test.mjs scripts/test/abracadabra-alakazam-account.test.mjs scripts/test/custom-services-catalog.test.mjs scripts/test/hosted-artifact.test.mjs scripts/test/local-deliverable-downloads.test.mjs scripts/test/payment-provider-placeholder.test.mjs scripts/test/domain-orchestration.test.mjs scripts/test/spaceship-provider-adapter.test.mjs server/commerce/test/offer-contract.test.mjs server/commerce/test/stripe-provider.test.mjs server/commerce-v2/test/*.test.mjs server/data-plane/tests/postgres-migration-structure.test.mjs",
    "test:domain": "node server/domain/assert-runtime.mjs && node --test scripts/test/domain-orchestration.test.mjs",
    "test:spaceship": "node server/domain/assert-runtime.mjs && node --test scripts/test/spaceship-provider-adapter.test.mjs",
    "test:selfhost": "npm run runtime:selfhost && node --test --test-concurrency=1 server/selfhost/test/*.test.mjs",
    "check:selfhost": "npm run runtime:selfhost && node --check server/selfhost/src/*.mjs server/selfhost/bin/*.mjs && node --test --test-concurrency=1 server/selfhost/test/*.test.mjs",
    "test:hosted-service": "npm run runtime:hosted-service && node --test --test-concurrency=1 server/hosted/test/*.test.mjs",
    "test:pg:migrations": "node server/data-plane/tests/verify-empty-postgres-migrations.mjs",
    "test:pg:alakazam": "node --test --test-concurrency=1 server/data-plane/tests/alakazam-postgres-contract.integration.test.mjs",
    "test:pg:custom-services": "node --test --test-concurrency=1 server/data-plane/tests/custom-services-foundation-postgres.integration.test.mjs server/data-plane/tests/custom-service-quotes-postgres.integration.test.mjs",
    "check:hosted-service": "npm run runtime:hosted-service && node --check server/hosted/*.mjs server/hosted/bin/*.mjs && npm run test:hosted-service",
    "test:ops": "node --test ops/test/*.test.mjs",
    "check:ops": "node --check ops/*.mjs && node --test --test-concurrency=1 ops/test/*.test.mjs",
    "ops:backup": "node ops/run-backup.mjs",
    "ops:backup:production-rehearsal": "node ops/run-production-rehearsal-backup.mjs",
    "ops:backup-cycle:production-rehearsal": "node ops/run-production-rehearsal-backup-cycle.mjs run",
    "ops:backup-cycle:recover-production-rehearsal": "node ops/run-production-rehearsal-backup-cycle.mjs recover",
    "ops:backup-retention": "node ops/apply-backup-retention.mjs",
    "ops:restore-verify": "node ops/verify-restore.mjs",
    "ops:monitor-held": "node ops/monitor-held.mjs",
    "ops:alert-delivery-proof": "node ops/prove-alert-delivery.mjs",
    "test:public-truth:legacy": "node --test scripts/test/public-truth-release.test.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "check:artifact": "node scripts/build-pages.mjs --check",
    "test": "npm run runtime:check && npm run check && npm run test:node && npm run check:selfhost && npm run check:hosted-service && npm run check:ops && npm run build:pages && npm run check:artifact && npm run check:hosted && npm run audit:browser"
  },
  "devDependencies": {
    "html-validate": "10.17.0"
  },
  "siteQuality": {
    "origin": "https://sitesourcery.com",
    "allowedFormActions": [],
    "expectedForms": 0
  },
  "license": "UNLICENSED",
  "dependencies": {
    "pg": "8.16.3",
    "stripe": "22.3.2"
  }
}
